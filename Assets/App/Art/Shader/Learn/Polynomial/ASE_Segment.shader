				half2 uv52 = UV22;
				half2 _PointA_Instance = UNITY_ACCESS_INSTANCED_PROP(ASEPolynomialFunctionASE_Segment,_PointA);
				half2 PointA20 = _PointA_Instance;
				half2 ub52 = PointA20;
				half _Radius_Instance = UNITY_ACCESS_INSTANCED_PROP(ASEPolynomialFunctionASE_Segment,_Radius);
				half radius52 = _Radius_Instance;
				half localcircle_algebraic_half52 = circle_algebraic_half( uv52 , ub52 , radius52 );
				half2 uv57 = UV22;
				half2 ub57 = PointA20;
				half radius57 = ( _Radius_Instance * 0.8 );
				half localcircle_algebraic_half57 = circle_algebraic_half( uv57 , ub57 , radius57 );
				half Circle_A58 = ( localcircle_algebraic_half52 - localcircle_algebraic_half57 );
				half2 uv29 = UV22;
				half2 _PointB_Instance = UNITY_ACCESS_INSTANCED_PROP(ASEPolynomialFunctionASE_Segment,_PointB);
				half2 PointB46 = _PointB_Instance;
				half2 ub29 = PointB46;
				half radius29 = _Radius_Instance;
				half localcircle_algebraic_half29 = circle_algebraic_half( uv29 , ub29 , radius29 );
				half2 uv35 = UV22;
				half2 ub35 = PointB46;
				half radius35 = ( _Radius_Instance * 0.8 );
				half localcircle_algebraic_half35 = circle_algebraic_half( uv35 , ub35 , radius35 );
				half Circle_B31 = ( localcircle_algebraic_half29 - localcircle_algebraic_half35 );
				half2 uv27 = UV22;
				half2 point_a27 = PointA20;
				half2 point_b27 = PointB46;
				half localsegment_polynomial_half27 = segment_polynomial_half( uv27 , point_a27 , point_b27 );
				half3 lerpResult32 = lerp( _ColorA , _ColorB , localsegment_polynomial_half27);
				half3 Segment_Polynomial33 = lerpResult32;
				half3 lerpResult38 = lerp( ( Circle_A58 + Circle_B31 + Segment_Polynomial33 ) , Segment_Polynomial33 , (float)_ShowCenter);
				
				float3 BakedAlbedo = 0;
				float3 BakedEmission = 0;
				float3 Color = lerpResult38;
				float Alpha = 1;
				float AlphaClipThreshold = 0.5;
				float AlphaClipThresholdShadow = 0.5;

				#ifdef ASE_DEPTH_WRITE_ON
					float DepthValue = input.positionCS.z;
				#endif

				#ifdef _ALPHATEST_ON
					clip(Alpha - AlphaClipThreshold);
				#endif

				InputData inputData = (InputData)0;
				inputData.positionWS = WorldPosition;
				inputData.viewDirectionWS = WorldViewDirection;

				#ifdef ASE_FOG
					inputData.fogCoord = InitializeInputDataFog(float4(inputData.positionWS, 1.0), input.fogFactorAndVertexLight.x);
				#endif
				#ifdef _ADDITIONAL_LIGHTS_VERTEX
					inputData.vertexLighting = input.fogFactorAndVertexLight.yzw;
				#endif

				inputData.normalizedScreenSpaceUV = NormalizedScreenSpaceUV;

				#if defined(_DBUFFER)
					ApplyDecalToBaseColor(input.positionCS, Color);
				#endif

				#ifdef ASE_FOG
					#ifdef TERRAIN_SPLAT_ADDPASS
						Color.rgb = MixFogColor(Color.rgb, half3(0,0,0), inputData.fogCoord);
					#else
						Color.rgb = MixFog(Color.rgb, inputData.fogCoord);
					#endif
				#endif

				#ifdef ASE_DEPTH_WRITE_ON
					outputDepth = DepthValue;
				#endif

				#ifdef _WRITE_RENDERING_LAYERS
					uint renderingLayers = GetMeshRenderingLayer();
					outRenderingLayers = float4( EncodeMeshRenderingLayer( renderingLayers ), 0, 0, 0 );
				#endif

				return half4( Color, Alpha );
			}
			ENDHLSL
