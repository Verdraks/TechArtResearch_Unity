#pragma kernel CSGrassDataSpawn

struct GrassData
{
    float3 position;    
};

RWStructuredBuffer<GrassData> grassDataBuffer;
uint grassDataBufferSize;

float3 areaGrassSize;
float3 areaGrassCenter;

[numthreads(64,1,1)]
void CSGrassDataSpawn (uint3 id : SV_DispatchThreadID)
{

    uint index = id.x;
    if (index >= grassDataBufferSize)
        return;
    
    uint gridWidth = sqrt(grassDataBufferSize);

    // Convertir index linéaire en coordonnées 2D
    uint x = index % gridWidth;
    uint z = index / gridWidth;

    // Normaliser entre 0 et 1
    float normalizedX = x / (float)gridWidth;
    float normalizedZ = z / (float)(grassDataBufferSize / gridWidth);

    // Position = centre + offset scaled par taille
    GrassData data;
    data.position = areaGrassCenter + float3(
        (normalizedX - 0.5f) * areaGrassSize.x,
        0,
        (normalizedZ - 0.5f) * areaGrassSize.z
    );

    grassDataBuffer[index] = data;
}
